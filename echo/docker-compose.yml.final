services:
  echo:
    build:
      context: .
      # Le build utilise le bridge Docker par défaut, dont le resolv.conf pointe
      # vers 192.168.1.1 — bloqué par la chain forward de worker_guard depuis le
      # durcissement du 2026-08-04. Les conteneurs compose ont le résolveur
      # embarqué de Docker ; le build, non. Réseau hôte = DNS de l'hôte, autorisé.
      network: host
    container_name: echo-bot
    restart: unless-stopped
    # Pas de root dans le conteneur.
    user: "1000:1000"
    environment:
      - TELEGRAM_TOKEN=${TELEGRAM_TOKEN}
      - GROQ_API_KEY=${GROQ_API_KEY}
      - TTS_ENGINE=xtts
      - XTTS_SPEAKER=Damien Black
      - KOKORO_MODEL=/models/kokoro-v1.0.onnx
      - KOKORO_VOICES=/models/voices-v1.0.bin
      - DICO_PATH=/data/dico.json
      - COQUI_TOS_AGREED=1
      # HOME=/tmp : la lib TTS cherche ses modèles sous ~/.local/share/tts,
      # donc /tmp/.local/share/tts vu le user 1000 sans home. Le volume XTTS
      # est monté exactement là.
      - HOME=/tmp
    volumes:
      - /home/st00mp/bots/v0x/kokoro_models:/models:ro
      - /home/st00mp/.local/share/tts:/tmp/.local/share/tts:ro
      - /home/st00mp/bots/echo/data:/data
    # XTTS résident ≈ 2,5 Go ; borne dure pour protéger GitLab et Minecraft.
    mem_limit: 4g
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "3"
